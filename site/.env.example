# Supabase — pegar em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — NUNCA expor no cliente, só usada em rotas de servidor (convites, admin)
SUPABASE_SERVICE_ROLE_KEY=

# Resend — pegar em resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="Planos <onboarding@resend.dev>"

# Gemini — pegar em aistudio.google.com/apikey (usado na Triagem com IA)
GEMINI_API_KEY=

# Segredo pra proteger a rota do cron diário (qualquer string aleatória longa)
CRON_SECRET=

# URL pública do site em produção (usada em links dentro dos emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do envio das planilhas do Drive (mesmo valor no script da planilha)
SYNC_SECRET=

# Conta de serviço do Google (Cloud Console) com a Calendar API ativada e
# permissão de edição na agenda de GOOGLE_CALENDAR_WRITE_ID — usada pelo
# botão "Adicionar triagem" pra criar o evento "T ..." de verdade.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ID da agenda onde o evento entra (o e-mail da conta do Google dona da agenda, pra agenda principal)
GOOGLE_CALENDAR_WRITE_ID=

# Z-API (z-api.io) — WhatsApp da notification_preferences.whatsapp_enabled.
# Instância + token ficam no painel da Z-API depois de conectar o número
# (escanear o QR code). Client-Token só existe em algumas contas/planos.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
